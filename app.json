{
  "expo": {
    "name": "Tracky",
    "slug": "tracky",
    "version": "1.0.1",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tracky",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/Tracky.icon",
      "buildNumber": "2",
      "bundleIdentifier": "com.bendsp.tracky",
      "config": {
        "usesNonExemptEncryption": false
      },
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font"
    ]
  }
}
